# =============================================================================
# Smartsend API Test Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- Required ---
BASE_URL=https://smartsend-dev-api.smartsend.uk/v1

# --- Authentication ---
# Set a valid Bearer token for API requests.
# If using email/password bootstrap, set TEST_BOOTSTRAP_EMAIL instead.
AUTH_TOKEN=

# --- Phone Verification Test Data ---
TEST_PHONE=+447700900123
TEST_OTP_CODE=123456

# --- Alternative Auth (for bootstrap login flow) ---
# TEST_BOOTSTRAP_EMAIL=testuser@smartsend.com
# TEST_BOOTSTRAP_PASSWORD=Password@2

# --- Test Configuration ---
TEST_TIMEOUT=30000
LOG_LEVEL=info

# --- Retry Configuration ---
RETRY_ENABLED=true
RETRY_COUNT=2
RETRY_DELAY_MS=1000

# --- Debug ---
# LOG_REQUEST_BODY=false
# LOG_RESPONSE_BODY=false
